#!/bin/sh
# xdg-open, Starling style — this dir is first on PATH for every app-run app.
#
# Third-party apps hand off URLs by exec'ing `xdg-open` (Electron
# shell.openExternal, Qt QDesktopServices, Chromium external protocols).
# Stock xdg-open resolves a handler from the HOST's desktop config and
# launches it BARE — on the dev box Slack's sign-in opened
# /opt/google/chrome/chrome with none of the flags the compositor needs
# (--use-angle=gl, --ozone-platform=wayland, scale) and the page never
# rendered. In the Starling model the app-run REGISTRY is the handler
# database: each record declares its schemes (`UrlSchemes=`), so a URL
# routes to the installed app that claims its scheme — web URLs to the
# browser, deep-link schemes back to their app (Electron/Chromium
# singletons forward the URL to the running instance — the sign-in return
# hop). This used to be a scheme table right here, which is exactly the
# apps-as-code drift the registry exists to prevent. Everything unclaimed
# falls through to the real xdg-open, best effort.
#
# For http/https, ~/.config/starling/default-apps (`browser=<id>`) picks
# among the records that declare them — the Default Apps pane writes it.
# An unset or uninstalled choice falls back to the first installed record
# claiming the scheme, so a missing config is a default, never an error.
#
# app-run exports STARLING_APP_RUN (its own resolved path) into every app
# it launches; the sibling-path fallbacks cover direct/manual invocation
# and, later, the image layout where both live in /usr/bin.
set -eu

URL="${1:-}"

APP_RUN="${STARLING_APP_RUN:-}"
if [ ! -x "$APP_RUN" ]; then
    APP_RUN="$(dirname "$(readlink -f "$0")")/../app-run.sh"
fi
[ -x "$APP_RUN" ] || APP_RUN=/usr/bin/app-run

CATALOG="${STARLING_CATALOG_DIR:-/usr/share/starling/catalog.d}"
RECORDS="${STARLING_APP_RECORDS:-/var/lib/starling/installed.d}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/starling/default-apps"

# Installed = app-install recorded it, or a catalog Bins= path exists (the
# hand-`apt install` case) — the same two probes the shell's registry runs.
installed() { # $1 = catalog file, $2 = id
    [ -f "$RECORDS/$2.app" ] && return 0
    bins=$(sed -n 's/^Bins=//p' "$1" | head -1)
    [ -n "$bins" ] || return 1
    old_ifs=$IFS; IFS=';'
    for b in $bins; do
        if [ -e "$b" ]; then IFS=$old_ifs; return 0; fi
    done
    IFS=$old_ifs
    return 1
}

# First installed record whose UrlSchemes claims the scheme.
resolve() { # $1 = scheme → app id on stdout
    for f in "$CATALOG"/*.app; do
        [ -f "$f" ] || continue
        grep -Eq "^UrlSchemes=([^;]*;)*$1(;|\$)" "$f" || continue
        id=$(sed -n 's/^Id=//p' "$f" | head -1)
        [ -n "$id" ] || continue
        installed "$f" "$id" || continue
        printf '%s\n' "$id"
        return 0
    done
    return 1
}

scheme="${URL%%:*}"
if [ -n "$scheme" ] && [ "$scheme" != "$URL" ]; then
    app=""
    case "$scheme" in
    http|https)
        # The configured browser wins — if it is still installed. A choice
        # pointing at a removed app silently yields to the fallback rather
        # than dead-ending every link on the desktop.
        choice=$(sed -n 's/^browser=//p' "$CONFIG" 2>/dev/null | head -1)
        if [ -n "$choice" ] && [ -f "$CATALOG/$choice.app" ] \
           && installed "$CATALOG/$choice.app" "$choice"; then
            app="$choice"
        fi
        ;;
    esac
    [ -n "$app" ] || app=$(resolve "$scheme") || app=""
    if [ -n "$app" ]; then
        exec "$APP_RUN" "$app" "$URL"
    fi
fi

# Not ours — hand it to the host's xdg-open (files, mailto, …).
if [ -x /usr/bin/xdg-open ]; then
    exec /usr/bin/xdg-open "$@"
fi
echo "starling xdg-open: no handler for '$URL'" >&2
exit 4
