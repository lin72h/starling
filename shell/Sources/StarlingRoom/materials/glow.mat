// Something that gives off light rather than taking it: the orrery's sun.
// Unlit, so it skips exposure, and above 1.0 so the bloom picks it up.
material {
    name : glow,
    shadingModel : unlit,
    parameters : [
        { type : float3, name : colour },
        { type : float, name : intensity }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor.rgb = materialParams.colour * materialParams.intensity;
    }
}
