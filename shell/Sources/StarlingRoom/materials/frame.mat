// The slab a window hangs in: a plain lit surface, so the room's sun and
// sky fall on it and it casts a shadow on the wall like a picture frame.
// With `useMap`, the slab is built of a world's blocks instead: `frameMap`
// is one block's tile, laid `block` metres to a tile over every face from
// the slab's own axes (a box needs no UVs for that — its scale is in the
// model matrix, and each face takes the two axes it lies in).
material {
    name : frame,
    shadingModel : lit,
    parameters : [
        { type : float3, name : baseColor },
        { type : float, name : roughness },
        { type : sampler2d, name : frameMap },
        { type : float, name : useMap },
        { type : float, name : block }
    ],
    variables : [
        { name : frameUv, precision : high }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        mat4 M = getWorldFromModelMatrix();
        vec3 sc = vec3(length(M[0].xyz), length(M[1].xyz), length(M[2].xyz));
        vec3 p = getPosition().xyz * sc;                        // metres, box-local
        vec3 n = abs(transpose(mat3(M)) * material.worldNormal); // which box axis
        vec2 uv = n.y > max(n.x, n.z) ? p.xz : (n.x > n.z ? p.zy : p.xy);
        material.frameUv = vec4(uv, 0.0, 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 c = materialParams.baseColor;
        if (materialParams.useMap > 0.5) {
            vec2 uv = variable_frameUv.xy / materialParams.block;
            // The tile is sRGB pixel art; the room is linear.
            c *= pow(texture(materialParams_frameMap, uv).rgb, vec3(2.2));
        }
        material.baseColor.rgb = c;
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;
    }
}
