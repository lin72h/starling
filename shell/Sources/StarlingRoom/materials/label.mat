// A label in the scene: an icon or a name drawn by the shell into a
// texture with alpha, on a quad that always faces the viewer. Unlit and
// blended, so the shape is the alpha and the rest is the sky behind.
material {
    name : label,
    shadingModel : unlit,
    blending : transparent,
    parameters : [
        { type : sampler2d, name : image },
        { type : float, name : intensity }
    ],
    requires : [ uv0 ],
    culling : none
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = texture(materialParams_image, getUV0());
        // The shell rasterises premultiplied; Filament blends straight
        // colour and premultiplies itself. Undo, then to linear.
        vec3 straight = c.rgb / max(c.a, 0.001);
        material.baseColor.rgb = pow(straight, vec3(2.2)) * materialParams.intensity;
        material.baseColor.a = c.a;
    }
}
