// A window's content, hung in the room: the client's texture, shown as
// the light a screen gives off. Unlit, because a display is a light
// source and not a surface the sun falls on; `intensity` is how bright
// a white pixel is in the room's units, so it survives the exposure the
// sunlit room is metered for. `flipY` for buffers whose first row is the
// top of the picture (Wayland), the same flag the shell's widget uses.
material {
    name : screen,
    shadingModel : unlit,
    parameters : [
        { type : sampler2d, name : content },
        { type : float, name : flipY },
        { type : float, name : intensity }
    ],
    requires : [ uv0 ],
    culling : back
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        if (materialParams.flipY > 0.5) uv.y = 1.0 - uv.y;
        vec3 c = texture(materialParams_content, uv).rgb;
        // The client's pixels are sRGB; the room is linear.
        material.baseColor.rgb = pow(c, vec3(2.2)) * materialParams.intensity;
    }
}
