// A block in the world with a picture on its faces — an app's icon as a
// thing that stands in the sun. Lit, so the sky and the sun shade its
// sides like any other block; the picture is the shell's raster
// (premultiplied, sRGB), unwound to a straight linear base colour.
material {
    name : block,
    shadingModel : lit,
    parameters : [
        { type : sampler2d, name : image }
    ],
    requires : [ uv0 ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = texture(materialParams_image, getUV0());
        vec3 straight = c.rgb / max(c.a, 0.001);
        material.baseColor.rgb = pow(straight, vec3(2.2));
        material.roughness = 0.75;
        material.metallic = 0.0;
    }
}
